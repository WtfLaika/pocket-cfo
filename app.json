{
  "expo": {
    "name": "Pocket CFO",
    "slug": "pocket-cfo",
    "scheme": "pocketcfo",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050810",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Pocket CFO to use Face ID to protect your financial data."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.wtflaika1337.pocketcfo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#050810"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.wtflaika1337.pocketcfo"
    }
  }
}
